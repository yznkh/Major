@{
    ViewData["Title"] = "الصفحة الرئيسية";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<title>@ViewData["Title"]</title>


<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        text-align: center;
        font-family: 'Poppins', sans-serif;
    }

    body {
        background: linear-gradient(81deg, #0d6efd75 0%, #fefefe 100%);
        min-height: 100vh;
        color: #fff;
        overflow-x: hidden;
        direction: rtl;
        position: relative;
    }

    /* تأثير Parallax للخلفية */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('/Image/Logo2.PNG') no-repeat center center;
            background-size: 20%;
            opacity: 0.2;
            z-index: -1;
        }

    /* تأثيرات عند التحميل */
    .fade-in {
        opacity: 0;
        transform: translateY(20px);
        animation: fadeIn 1s ease-out forwards;
    }

    .container {
        max-width: 90%;
    }

    header h1 {
        font-size: 2.5rem;
        font-weight: bold;
        margin-bottom: 20px;
        text-shadow: 2px 2px 10px rgba(255, 215, 0, 0.8);
    }

    .row {
        display: flex;
        justify-content: center;
        gap: 25px;
        margin-top: 50px;
        flex-wrap: wrap;
    }

    /* تأثير Glassmorphism للبطاقات */
    .card {
        background: rgba(255, 255, 255, 0.15);
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        transition: all 0.4s ease-in-out;
        width: 320px;
        padding: 25px;
        backdrop-filter: blur(15px);
        transform: perspective(1000px) rotateY(0);
    }

    .card p{
            color: black;
            font-weight: bolder;
          
    }

    .card:hover {
        transform: perspective(1000px) rotateY(5deg);
            box-shadow: 0 15px 50px #052ee280;
    }

    .card-title {
        color: #0a58ca;
        font-size: 1.6rem;
        position: relative;
        margin-bottom: 15px;
        text-shadow: 1px 1px 15px #007bff;
    }

    .card-title i {
        margin-left: 10px;
        color: #ffd700;
    }

    /* أزرار 3D مع تأثير متوهج */
    .btn {
        border-radius: 50px;
        padding: 14px 35px;
        background: linear-gradient(45deg, #ffcc00, #ff6600);
        border: none;
        transition: all 0.3s ease;
        color: white;
        font-size: 1.1rem;
        text-decoration: none;
        display: inline-block;
        margin-top: 15px;
        cursor: pointer;
        font-weight: bold;
        box-shadow: 0 5px 20px rgba(255, 140, 0, 0.5);
        position: relative;
    }

    .btn::before {
        content: '';
        position: absolute;
        top: -5px;
        left: -5px;
        right: -5px;
        bottom: -5px;
        background: rgba(255, 140, 0, 0.4);
        border-radius: 50px;
        filter: blur(8px);
        z-index: -1;
        transition: 0.3s;
    }

    .btn:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(255, 140, 0, 0.8);
    }

    /* تحسين صندوق المعلومات */
    .info-card {
        background: rgba(255, 255, 255, 0.15);
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        padding: 25px;
        margin-top: 50px;
        text-align: center;
        backdrop-filter: blur(10px);
    }

    .info-card h2 {
            color: #0d6efd;
        font-size: 1.9rem;
        margin-bottom: 20px;
            text-shadow: 1px 1px 15px #007bff;
    }

    .info-card ul {
        list-style-type: none;
        padding-right: 20px;
    }

    .info-card li {
        margin-bottom: 12px;
        font-size: 1.2rem;
    }

    .info-card li::before {
        content: "✓";
        color: #ffcc00;
        margin-left: 12px;
        font-weight: bold;
    }


    /* تحريك الشريط الإخباري */
    </style>
<div class="container text-right">
    <header>
        <h1>إدارة القطاعات والشركات</h1>
        <div class="news-ticker">
            <p>مديرية السياسات والامتثال / قسم البنى التحتية الحرجة</p>
        </div>
    </header>
    <div>
        <br />
        <br />
    </div>
    <main class="my-4">
        <div class="row">
            @if (User.HasClaim("CanRead", "True"))
            {
                <div class="card">
                    <h2 class="card-title"><i class="fas fa-industry"></i> القطاعات</h2>
                    <p>استعرض القطاعات الرئيسية والفرعية وأضف قطاعاً جديداً.</p>
                    <a href="/Sectors" class="btn">عرض القطاعات</a>
                </div>
                <div class="card">
                    <h2 class="card-title"><i class="fas fa-cogs"></i> الخدمات</h2>
                    <p>استعرض الخدمات المقدمة لكل قطاع فرعي وأضف خدمة جديدة.</p>
                    <a href="/Services" class="btn">عرض الخدمات</a>
                </div>
                <div class="card">
                    <h2 class="card-title"><i class="fas fa-building"></i> الشركات</h2>
                    <p>استعرض الشركات المسجلة وأضف شركة جديدة.</p>
                    <a href="/Companies" class="btn">عرض الشركات</a>
                </div>
            }
            else
            {
                <p class="text-danger text-center">غير مصرح لك بعرض أي محتوى.</p>
            }
        </div>

        <div class="info-card">
            <h2>معلومات البنية التحتية الحرجة</h2>
            <ul style="color:black;">
                <li>تعريف البنية التحتية الحرجة: مجموعة الأنظمة والشبكات الإلكترونية والأصول المادية وغير المادية أو الأصول السيبرانية والأنظمة التي يعد تشغيلها المستمر ضرورة لضمان أمن الدولة واقتصادها وسلامة المجتمع.</li>
                <li>أهمية تحديد البنى التحتية الحرجة: المساعدة في وضع المعايير والضوابط الأمنية لحماية البنية التحتية الحرجة من ناحية، ومن ناحية أخرى المساعدة على تصنيف الحوادث السيبرانية وآلية الاستجابة لها.</li>
                <li>
                    المعايير الأساسية لتصنيف القطاع الحرج:
                    <ol>
                        <li>أمن الدولة.</li>
                        <li>الاقتصاد.</li>
                        <li>سلامة المجتمع.</li>
                    </ol>
                </li>
                <li>السند القانوني: قانون الأمن السيبراني رقم 16 لسنة 2019 والتي نصت على: "ب- يتولى المركز في سبيل تحقيق أهدافه المهام والصلاحيات التالية: 10. تحديد شبكات البنى التحتية الحرجة ومتطلبات استدامتها".</li>
            </ul>
        </div>
    </main>
</div>
